  "ui.screen_reader.page_title": {
    "text": "Trimps 5.10.1 (Screen Reader version)",
    "title": null
  },
  "ui.screen_reader.info_title": {
    "text": "Screen Reader Information",
    "title": null
  },
  "ui.screen_reader.info_line_1": {
    "text": "This game uses several different ways to show additional information in tooltips.",
    "title": null
  },
  "ui.screen_reader.info_line_2": {
    "text": "shift+/ will work on all elements, but requires focus, and specific NVDA settings. All elements with additional information are focusable with tab.",
    "title": null
  },
  "ui.screen_reader.info_line_3": {
    "text": "shift+enter works only on button elements, not clickable. It does not require focus.",
    "title": null
  },
  "ui.screen_reader.info_line_4": {
    "text": "You can also enable separate info buttons, which will respond to enter.",
    "title": null
  },
  "ui.screen_reader.info_line_5": {
    "text": "To enable shift+/ tooltips, Turn NVDA + 8 on, and disable NVDA: Settings > browse mode: Disable \"trap all command gestures from reaching the document.\"",
    "title": null
  },
  "ui.screen_reader.info_line_6": {
    "text": "You can show/hide this information via the game setting \"Show Screen Read Info.\"",
    "title": null
  },
